# Copiar a .env.local y completar en el equipo de trabajo.
# El cliente API debe cargar este archivo explícitamente; no se carga solo.
# Hostname confirmado de cPanel, HTTPS y puerto del proveedor.
# Sin /cpsess..., sin query string y sin credenciales dentro de la URL.
CPANEL_BASE_URL=https://HOSTNAME_CONFIRMADO:2083
CPANEL_USERNAME=COMPLETAR_USUARIO
CPANEL_API_TOKEN=COMPLETAR_LOCALMENTE

# Sitio objeto del diagnóstico; no es necesariamente el hostname de cPanel.
RENDER_SITE_URL=https://rendermultimedia.com
# Completar solamente después de confirmar la raíz real en cPanel/API.
RENDER_DOCUMENT_ROOT=
